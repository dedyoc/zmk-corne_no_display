#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &five_column_transform;
    };
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
        };

        // Home row mods, "timerless" style (urob). The long tapping-term is
        // deliberate: require-prior-idle-ms does the real work by forcing a tap
        // whenever the key is pressed within 150ms of another key, which is what
        // fast typing looks like. hold-trigger-on-release defers the positional
        // check to release so two mods on the same hand can still be combined.
        // Tuning: same-hand false mods -> raise tapping-term-ms;
        //         cross-hand false mods -> raise require-prior-idle-ms;
        //         missed mods when typing fast -> lower require-prior-idle-ms.
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        osm: osm {
            compatible = "zmk,behavior-sticky-key";
            label = "OSM";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            lazy;
            ignore-modifiers;
            quick-release;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp INS>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "COPY";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp INS>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "PASTE";
        };

        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp DEL>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "CUT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // ---------------------------------------------------------------------------------------------
            // | PASTE |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |     |
            // | COPY  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  '  |     |
            // | CUT   |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | TD0 |
            //                    | ESC | TAB | SPC |   | ENT | BSPC | DEL |
            //
            // Left column is paste/copy/cut (Shift+Ins / Ctrl+Ins / Shift+Del) -- terminal-safe.
            // Home row is mods: A=GUI S=ALT D=SHFT F=CTRL / J=CTRL K=SHFT L=ALT '=GUI.
            // Thumbs are layer-taps: TAB=L1 SPC=L4 ENT=L2 BSPC=L3. TD0 = caps-word / CAPS.
            // Positions 11 and 23 are unassigned.

            bindings = <
&paste  &kp Q        &kp W        &kp E         &kp R         &kp T          &kp Y        &kp U         &kp I         &kp O        &kp P                   &trans
&copy   &hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F  &kp G          &kp H        &hmr RCTRL J  &hmr RSHFT K  &hmr RALT L  &hmr RGUI SINGLE_QUOTE  &trans
&cut    &kp Z        &kp X        &kp C         &kp V         &kp B          &kp N        &kp M         &kp COMMA     &kp DOT      &kp FSLH                &td0
                                  &kp ESC       &lt 1 TAB     &lt 4 SPACE    &lt 2 ENTER  &lt 3 BSPC    &kp DEL
            >;
        };

        lower_layer {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------------------
            // |     |   1    |   2   |   3   |   4   |   5   |   |   6  |   7  |  8  |  9  |  0   | BSPC |
            // |     | BT_CLR | BT 0  | BT 1  | BT 2  | BT 3  |   | LEFT | DOWN |  UP | RGT | HOME | PGUP |
            // |     | RGB_TOG|       |       |       |RGB_EFF|   | SPD  | SPI  | BRI | BRD | END  | PGDN |
            //                       |     |     |     |   |     |     |     |
            //
            // BT_CLR here is BT_CLR_ALL (wipes every profile), not BT_CLR.

            bindings = <
&trans  &kp N1           &kp N2        &kp N3        &kp N4        &kp N5             &kp N6           &kp N7           &kp N8           &kp N9           &kp N0    &kp BSPC
&trans  &bt BT_CLR_ALL   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3       &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp HOME  &kp PG_UP
&trans  &rgb_ug RGB_TOG  &trans        &trans        &trans        &rgb_ug RGB_EFF    &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp END   &kp PG_DN
                                       &trans        &trans        &trans             &trans           &trans           &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------
            // |     |  `  |  ~  |  #  |  &  | "|" |   |  ^  |  {  |  }  |  ;  |     |     |
            // |     |  !  |  _  |  :  |  =  |  "  |   |  @  |  (  |  )  |  [  |  ]  |     |
            // |     |  %  |  ?  |  *  |  +  |  \  |   |  /  |  -  |  <  |  >  |  $  |     |
            //                   |     |     |     |   |     |     |     |

            bindings = <
&trans  &kp GRAVE    &kp TILDE  &kp HASH   &kp AMPS   &kp PIPE             &kp CARET  &kp LBRC              &kp RBRC               &kp SEMI          &trans             &trans
&trans  &kp EXCL     &kp UNDER  &kp COLON  &kp EQUAL  &kp DOUBLE_QUOTES    &kp AT     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans  &kp PERCENT  &kp QMARK  &kp ASTRK  &kp PLUS   &kp BACKSLASH        &kp SLASH  &kp MINUS             &kp LT                 &kp GT            &kp DOLLAR         &trans
                                &trans     &trans     &trans               &trans     &trans                &trans
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
&trans  &kp F1      &kp F2        &kp F3  &kp F4      &kp F5    &kp F6       &kp F7  &kp F8  &kp F9  &kp F10          &kp F11
&trans  &bt BT_CLR  &out OUT_TOG  &trans  &sys_reset  &trans    &trans       &trans  &trans  &trans  &kp PRINTSCREEN  &kp F12
&trans  &trans      &trans        &trans  &trans      &trans    &bootloader  &trans  &trans  &trans  &trans           &kp PAUSE_BREAK
                                  &trans  &trans      &trans    &trans       &trans  &trans
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans     &trans     &trans      &trans      &trans         &trans          &trans          &trans        &trans           &trans  &trans
&trans  &osm LGUI  &osm LALT  &osm LSHFT  &osm LCTRL  &trans         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans     &trans     &trans      &trans      &trans         &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &trans
                              &trans      &trans      &trans         &mkp MB1        &mkp MB2        &mkp MB3
            >;
        };
    };
};
